{
  "info": {
    "_postman_id": "f5d0b2d4-8d2f-4fe7-a07b-1a0d4cf8f236",
    "name": "自习室管理系统 MVP",
    "description": "覆盖认证、学生预约、防爽约黑名单与管理员接口。",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "认证",
      "item": [
        {
          "name": "注册（学生）",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phone\": \"{{studentPhone}}\",\n  \"password\": \"{{studentPassword}}\",\n  \"nickname\": \"{{studentNickname}}\"\n}"
            },
            "url": "{{baseUrl}}/api/auth/register"
          }
        },
        {
          "name": "登录（学生）",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "pm.environment.set('accessToken', json.access_token);",
                  "pm.environment.set('refreshToken', json.refresh_token);",
                  "pm.environment.set('currentUserId', String(json.user.id));",
                  "pm.environment.set('currentRole', json.user.role);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"account\": \"{{studentAccount}}\",\n  \"password\": \"{{studentPassword}}\"\n}"
            },
            "url": "{{baseUrl}}/api/auth/login"
          }
        },
        {
          "name": "刷新令牌",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "pm.environment.set('accessToken', json.access_token);",
                  "pm.environment.set('refreshToken', json.refresh_token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refresh_token\": \"{{refreshToken}}\"\n}"
            },
            "url": "{{baseUrl}}/api/auth/refresh"
          }
        },
        {
          "name": "退出登录",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refresh_token\": \"{{refreshToken}}\"\n}"
            },
            "url": "{{baseUrl}}/api/auth/logout"
          }
        }
      ]
    },
    {
      "name": "学生端",
      "item": [
        {
          "name": "门店列表",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const list = pm.response.json();",
                  "if (Array.isArray(list) && list.length > 0) {",
                  "  pm.environment.set('storeId', String(list[0].id));",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": "{{baseUrl}}/api/student/stores"
          }
        },
        {
          "name": "座位列表",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const list = pm.response.json();",
                  "if (Array.isArray(list) && list.length > 0) {",
                  "  pm.environment.set('seatId', String(list[0].id));",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": "{{baseUrl}}/api/student/seats?store_id={{storeId}}"
          }
        },
        {
          "name": "创建预约",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.booking_id) {",
                  "  pm.environment.set('bookingId', String(json.booking_id));",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"seat_id\": {{seatId}},\n  \"start_time\": \"{{bookingStart}}\",\n  \"end_time\": \"{{bookingEnd}}\"\n}"
            },
            "url": "{{baseUrl}}/api/student/bookings"
          }
        },
        {
          "name": "我的预约",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": "{{baseUrl}}/api/student/bookings/me"
          }
        },
        {
          "name": "取消预约",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": "{{baseUrl}}/api/student/bookings/{{bookingId}}/cancel"
          }
        }
      ]
    },
    {
      "name": "管理员端",
      "item": [
        {
          "name": "登录（管理员）",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "pm.environment.set('adminAccessToken', json.access_token);",
                  "pm.environment.set('adminRefreshToken', json.refresh_token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"account\": \"{{adminAccount}}\",\n  \"password\": \"{{adminPassword}}\"\n}"
            },
            "url": "{{baseUrl}}/api/auth/login"
          }
        },
        {
          "name": "手动初始化门店数据",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminAccessToken}}"
              }
            ],
            "url": "{{baseUrl}}/api/admin/bootstrap"
          }
        },
        {
          "name": "黑名单列表",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminAccessToken}}"
              }
            ],
            "url": "{{baseUrl}}/api/admin/blacklists"
          }
        },
        {
          "name": "手动拉黑用户",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminAccessToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"user_id\": {{currentUserId}},\n  \"reason\": \"人工风控测试\"\n}"
            },
            "url": "{{baseUrl}}/api/admin/blacklists"
          }
        },
        {
          "name": "移出黑名单",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminAccessToken}}"
              }
            ],
            "url": "{{baseUrl}}/api/admin/blacklists/{{currentUserId}}?reset_no_show_count=false"
          }
        },
        {
          "name": "统计概览",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminAccessToken}}"
              }
            ],
            "url": "{{baseUrl}}/api/admin/stats/overview?store_id={{storeId}}&date={{statDate}}"
          }
        }
      ]
    }
  ]
}
